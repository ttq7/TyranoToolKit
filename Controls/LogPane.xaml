<UserControl x:Class="TyranoToolKit.Controls.LogPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgAltBrush}"
             BorderBrush="{StaticResource BorderBrush}"
             BorderThickness="1">
    <Grid>
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="8">
            <TextBlock x:Name="LogText" FontFamily="Consolas, 'Cascadia Mono', monospace" FontSize="12" TextWrapping="NoWrap" Text=""/>
        </ScrollViewer>
        <Button x:Name="ClearBtn" Style="{StaticResource SecondaryButton}" Content="清空" Padding="8,4" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" Opacity="0.6" Click="ClearBtn_Click"/>
    </Grid>
</UserControl>
